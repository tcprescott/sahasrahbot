# Coverage for `pytest --cov`. Measures the bot's own packages, including the
# Discord cogs (which have no __init__.py, so they're listed by path).
[run]
source =
    alttprbot
    alttprbot_api
    alttprbot_discord
    alttprbot_discord/cogs
    alttprbot_racetime
omit =
    */__pycache__/*

[report]
skip_empty = true
# CI runs pytest with --cov, so the suite fails if coverage drops below this.
# Raise it when coverage goes up; don't lower it to make a PR pass.
fail_under = 90
